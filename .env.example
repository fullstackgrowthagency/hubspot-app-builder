# Required: key used to encrypt stored client/portal Personal Access Keys at rest
HAB_SECRET_KEY=

# Runtime settings
HAB_DATA_DIR=./data
HAB_PORT=4173
HAB_HOST=127.0.0.1

# Optional: require HTTP Basic Auth. Strongly recommended once this app is
# reachable on the open internet (not just localhost) — it stores client
# credentials and can trigger real HubSpot deploys. Leave both unset for
# localhost-only development.
HAB_BASIC_AUTH_USER=
HAB_BASIC_AUTH_PASSWORD=
